# Copy this file to .env and fill in real values for your local environment.
# Never commit the resulting .env file.

# Port the Express server listens on
# Note: on macOS, port 5000 is often occupied by the AirPlay Receiver
# (System Settings > General > AirDrop & Handoff) — 5001 avoids that clash.
PORT=5001

# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/rotimatic_next
DATABASE_URL=postgresql://username:password@localhost:5432/rotimatic_next

# Reserved for future use. The current session design (see the
# "Authentication" section in README.md) uses an unsigned, opaque
# PostgreSQL-generated UUID as the session id, looked up directly against
# the sessions table — there's no embedded data to sign/protect, so this
# value isn't read by the auth code yet. Still: keep it long/random and
# never commit a real value, since something later may need it.
SESSION_SECRET=replace_with_a_long_random_string

# Origin of the static frontend, used for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5500

# Razorpay server-side credentials. Never expose the secret values to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
